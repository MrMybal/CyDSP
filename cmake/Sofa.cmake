# Optional importers and data preparation; the core never links file-format libraries.
option(CYDSP_BUILD_SOFA "Build optional memory-only SOFA import" OFF)
option(CYDSP_BUILD_HRTF_ASSETS "Build optional decoded-HRTF preparation and cache" OFF)
option(CYDSP_SOFA_COMPACT "Build the compact libmysofa reader" ON)
option(CYDSP_SOFA_COMPLETE "Build the complete float64 HDF5 reader (external SDK)" OFF)
set(CYDSP_PACKAGE_HDF5 OFF)
if(CYDSP_BUILD_SOFA OR CYDSP_BUILD_HRTF_ASSETS)
    add_library(CyDSPHrtfAssets STATIC src/sofa/HrtfAssets.cpp)
    add_library(CyDSP::HrtfAssets ALIAS CyDSPHrtfAssets)
    set_target_properties(CyDSPHrtfAssets PROPERTIES EXPORT_NAME HrtfAssets POSITION_INDEPENDENT_CODE ON)
    target_link_libraries(CyDSPHrtfAssets PUBLIC CyDSP::CyDSP)
    target_include_directories(CyDSPHrtfAssets PRIVATE src)
    install(TARGETS CyDSPHrtfAssets EXPORT CyDSPTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
endif()
if(CYDSP_BUILD_SOFA)
    if(NOT CYDSP_SOFA_COMPACT AND NOT CYDSP_SOFA_COMPLETE)
        message(FATAL_ERROR "Enable at least one SOFA reader")
    endif()
    add_library(CyDSPSofa STATIC src/sofa/Sofa.cpp)
    add_library(CyDSP::Sofa ALIAS CyDSPSofa)
    set_target_properties(CyDSPSofa PROPERTIES EXPORT_NAME Sofa POSITION_INDEPENDENT_CODE ON)
    target_include_directories(CyDSPSofa PRIVATE src)
    target_link_libraries(CyDSPSofa PUBLIC CyDSP::HrtfAssets)
    target_compile_definitions(CyDSPSofa PRIVATE CYDSP_SOFA_COMPACT=$<BOOL:${CYDSP_SOFA_COMPACT}> CYDSP_SOFA_COMPLETE=$<BOOL:${CYDSP_SOFA_COMPLETE}>)
    if(CYDSP_SOFA_COMPACT)
        enable_language(C)
        include(cmake/SofaCompact.cmake)
    endif()
    if(CYDSP_SOFA_COMPLETE)
        enable_language(C)
        find_package(HDF5 1.14.6 REQUIRED COMPONENTS C)
        find_package(ZLIB REQUIRED)
        target_sources(CyDSPSofa PRIVATE src/sofa/SofaHdf5.cpp)
        target_include_directories(CyDSPSofa PRIVATE ${HDF5_INCLUDE_DIRS})
        target_link_libraries(CyDSPSofa PRIVATE HDF5::HDF5 ZLIB::ZLIB)
        if(WIN32)
            target_link_libraries(CyDSPSofa PRIVATE shlwapi)
        endif()
        set(CYDSP_PACKAGE_HDF5 ON)
    endif()
    install(TARGETS CyDSPSofa EXPORT CyDSPSofaTargets ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
    install(EXPORT CyDSPSofaTargets NAMESPACE CyDSP:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/CyDSP)
endif()
foreach(t CyDSPHrtfAssets CyDSPSofa)
    if(TARGET ${t})
        if(MSVC)
            target_compile_options(${t} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:/W4;/permissive-;/fp:strict;/utf-8>)
        else()
            target_compile_options(${t} PRIVATE -Wall -Wextra -Wpedantic -ffp-contract=off)
        endif()
    endif()
endforeach()

if(CYDSP_BUILD_SOFA AND CYDSP_BUILD_TESTS)
    add_executable(cydsp_sofa_tests tests/SofaRegression.cpp tests/RealtimeRegression.cpp)
    target_link_libraries(cydsp_sofa_tests PRIVATE CyDSP::Sofa)
    target_compile_definitions(cydsp_sofa_tests PRIVATE CYDSP_SOFA_FIXTURES="${CMAKE_CURRENT_SOURCE_DIR}/tests/data/sofa")
    add_test(NAME cydsp_sofa_regression COMMAND cydsp_sofa_tests)
endif()
