@PACKAGE_INIT@
set(CyDSP_HRTF_DATA_DIR "")
if(@CYDSP_INSTALL_HRTF_DATA@)
    set(CyDSP_HRTF_DATA_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/CyDSP/hrtf/sadie-ii-v2-2")
endif()
include(CMakeFindDependencyMacro)
if(@CYDSP_PACKAGE_THREADS@)
    find_dependency(Threads)
endif()
if(@CYDSP_PACKAGE_ALSA@)
    find_dependency(ALSA)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CyDSPTargets.cmake")
if("Sofa" IN_LIST CyDSP_FIND_COMPONENTS AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/CyDSPSofaTargets.cmake")
    if(@CYDSP_PACKAGE_HDF5@)
        find_dependency(HDF5 1.14.6 COMPONENTS C)
        find_dependency(ZLIB)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/CyDSPSofaTargets.cmake")
endif()
foreach(component IN LISTS CyDSP_FIND_COMPONENTS)
    if(component STREQUAL "CyDSP")
        set(CyDSP_${component}_FOUND TRUE)
    elseif(TARGET CyDSP::${component})
        set(CyDSP_${component}_FOUND TRUE)
    else()
        set(CyDSP_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(CyDSP)
