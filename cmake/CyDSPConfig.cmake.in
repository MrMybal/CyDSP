@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@CYDSP_PACKAGE_THREADS@)
    find_dependency(Threads)
endif()
if(@CYDSP_PACKAGE_ALSA@)
    find_dependency(ALSA)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/CyDSPTargets.cmake")
foreach(component IN LISTS CyDSP_FIND_COMPONENTS)
    if(component STREQUAL "CyDSP")
        set(CyDSP_${component}_FOUND TRUE)
    elseif(TARGET CyDSP::${component})
        set(CyDSP_${component}_FOUND TRUE)
    else()
        set(CyDSP_${component}_FOUND FALSE)
    endif()
endforeach()
check_required_components(CyDSP)
