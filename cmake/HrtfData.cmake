# Measurements stay outside the static archive and are installed only on request.
option(CYDSP_INSTALL_HRTF_DATA "Install the optional SADIE II HRTF selection (below 100 MB)" OFF)
option(CYDSP_TEST_HRTF_DATA "Build explicit native checks of the measured HRTF files" OFF)
set(CYDSP_HRTF_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/data/hrtf/sadie-ii-v2-2")
if(CYDSP_INSTALL_HRTF_DATA)
    foreach(cydsp_hrtf_required IN ITEMS manifest.json LICENSE.txt NOTICE.txt
            D1_48K_24bit_256tap_FIR_SOFA.sofa D2_48K_24bit_256tap_FIR_SOFA.sofa
            H10_48K_24bit_256tap_FIR_SOFA.sofa)
        if(NOT EXISTS "${CYDSP_HRTF_SOURCE_DIR}/${cydsp_hrtf_required}")
            message(FATAL_ERROR "Missing optional HRTF file: ${cydsp_hrtf_required}")
        endif()
    endforeach()
    file(GLOB_RECURSE cydsp_hrtf_files LIST_DIRECTORIES false "${CYDSP_HRTF_SOURCE_DIR}/*")
    set(cydsp_hrtf_bytes 0)
    foreach(cydsp_hrtf_file IN LISTS cydsp_hrtf_files)
        file(SIZE "${cydsp_hrtf_file}" cydsp_hrtf_file_bytes)
        math(EXPR cydsp_hrtf_bytes "${cydsp_hrtf_bytes} + ${cydsp_hrtf_file_bytes}")
    endforeach()
    if(cydsp_hrtf_bytes GREATER_EQUAL 100000000 OR NOT EXISTS "${CYDSP_HRTF_SOURCE_DIR}/manifest.json")
        message(FATAL_ERROR "The optional HRTF selection is missing or exceeds its strict 100 MB budget")
    endif()
    install(DIRECTORY "${CYDSP_HRTF_SOURCE_DIR}/"
            DESTINATION ${CMAKE_INSTALL_DATADIR}/CyDSP/hrtf/sadie-ii-v2-2 COMPONENT HrtfData)
endif()
if(CYDSP_TEST_HRTF_DATA)
    if(NOT CYDSP_BUILD_TESTS OR NOT CYDSP_BUILD_SOFA)
        message(FATAL_ERROR "HRTF data tests require CYDSP_BUILD_TESTS and CYDSP_BUILD_SOFA")
    endif()
    add_executable(cydsp_hrtf_data_tests tests/HrtfDataRegression.cpp)
    target_link_libraries(cydsp_hrtf_data_tests PRIVATE CyDSP::Sofa)
    target_compile_definitions(cydsp_hrtf_data_tests PRIVATE
        CYDSP_HRTF_DATA_DIR="${CYDSP_HRTF_SOURCE_DIR}")
    add_test(NAME cydsp_hrtf_data_regression COMMAND cydsp_hrtf_data_tests)
endif()
