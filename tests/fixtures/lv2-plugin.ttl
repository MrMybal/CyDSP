@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix worker: <http://lv2plug.in/ns/ext/worker#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix pg: <http://lv2plug.in/ns/ext/port-groups#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .
<urn:cydsp:group:main> lv2:name "Main" .
<urn:cydsp:group:side> lv2:name "Sidechain" .
<urn:cydsp:lv2-fixture> a lv2:Plugin ;
    doap:name "CyDSP original LV2 fixture" ;
    lv2:requiredFeature urid:map, worker:schedule ;
    lv2:extensionData state:interface, worker:interface ;
    ui:ui <urn:cydsp:lv2-fixture-ui> ;
    lv2:port [
      a lv2:InputPort, lv2:AudioPort ; lv2:index 0 ; pg:group <urn:cydsp:group:main> ; lv2:symbol "left" ; lv2:name "Left"
    ], [
      a lv2:InputPort, lv2:AudioPort ; lv2:index 1 ; pg:group <urn:cydsp:group:main> ; lv2:symbol "right" ; lv2:name "Right"
    ], [
      a lv2:OutputPort, lv2:AudioPort ; lv2:index 2 ; pg:group <urn:cydsp:group:main> ; lv2:symbol "out_left" ; lv2:name "Left"
    ], [
      a lv2:OutputPort, lv2:AudioPort ; lv2:index 3 ; pg:group <urn:cydsp:group:main> ; lv2:symbol "out_right" ; lv2:name "Right"
    ], [
      a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ;
      lv2:default 0.5 ; lv2:minimum 0.0 ; lv2:maximum 2.0
    ], [
      a lv2:InputPort, atom:AtomPort ; lv2:index 5 ; lv2:symbol "midi_in" ; lv2:name "MIDI" ;
      atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent, time:Position
    ], [
      a lv2:OutputPort, atom:AtomPort ; lv2:index 6 ; lv2:symbol "midi_out" ; lv2:name "MIDI" ;
      atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent
    ], [
      a lv2:OutputPort, lv2:ControlPort ; lv2:index 7 ; lv2:symbol "latency" ; lv2:name "Latency" ;
      lv2:designation lv2:latency ; lv2:portProperty lv2:reportsLatency, lv2:integer ;
      lv2:minimum 0 ; lv2:maximum 8192 ; lv2:default 11
    ], [
      a lv2:OutputPort, lv2:ControlPort ; lv2:index 8 ; lv2:symbol "worked" ; lv2:name "Worker" ;
      lv2:minimum 0 ; lv2:maximum 1000 ; lv2:default 0
    ], [
      a lv2:InputPort, lv2:AudioPort ; lv2:index 9 ; lv2:symbol "side" ; lv2:name "Sidechain" ;
      pg:group <urn:cydsp:group:side>
    ] .
